{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@lahm/tokens": [
        "../../packages/tokens/src/index.ts"
      ],
      "@lahm/tokens/*": [
        "../../packages/tokens/src/*"
      ],
      "@lahm/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@lahm/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@lahm/api": [
        "../../packages/api/src/index.ts"
      ],
      "@lahm/api/*": [
        "../../packages/api/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
