{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "allowJs": true,
    "paths": {
      "@lahm/tokens": ["../tokens/src/index.ts"],
      "@lahm/tokens/*": ["../tokens/src/*"]
    }
  },
  "include": ["src/**/*"]
}
