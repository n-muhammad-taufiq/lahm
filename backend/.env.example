# For Codespaces, set DB_URL as a Codespaces secret/environment variable instead.
# DB_URL=postgresql://user:password@host/database?sslmode=require

# Local PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_local_password
DB_NAME=lahm

# Generate unique random values for local development; do not reuse in production.
JWT_ACCESS_TOKEN_SECRET=replace_with_a_random_secret
JWT_REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret
